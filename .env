# Copy this file to ".env" and fill in real values.
# .env is gitignored — never commit real keys.

# Required for real AI-generated itineraries.
# Get a key at https://console.anthropic.com/settings/keys
# If this is left blank, the app runs in DEMO MODE with sample itineraries.
ANTHROPIC_API_KEY=

# Optional — override the default model (defaults to claude-sonnet-5 if unset).
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional — reserved for plugging in a real flight/hotel pricing provider
# (e.g. Amadeus Self-Service API) inside backend/services/travel_service.py.
# Not required to run the app; distance-based estimates are used otherwise.
TRAVEL_API_KEY=

# Optional Flask settings
FLASK_DEBUG=true
PORT=5000
